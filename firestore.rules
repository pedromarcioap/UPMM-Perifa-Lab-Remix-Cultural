rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if (isSignedIn() && (request.auth.uid == userId || userId.size() <= 128)) || (userId is string && userId.size() <= 128);
      allow update: if isSignedIn() || (userId is string && userId.size() <= 128);
      allow delete: if isOwner(userId);
    }

    // Badges Collection (Reward Badges CMS)
    match /badges/{badgeId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() || (badgeId is string && badgeId.size() <= 128);
    }

    // Photos & Remixes Collection
    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if isSignedIn() || (photoId is string && photoId.size() <= 128);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'pedromarcioap@gmail.com');
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create, update: if isSignedIn() || (commentId is string && commentId.size() <= 128);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'pedromarcioap@gmail.com');
    }

    // Graffiti Spots Collection
    match /graffitiSpots/{spotId} {
      allow read: if true;
      allow create, update: if isSignedIn() || (spotId is string && spotId.size() <= 128);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'pedromarcioap@gmail.com');
    }

    // Weekly Challenges Collection
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isSignedIn() || (challengeId is string && challengeId.size() <= 128);
    }

    // Remix Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() || (notificationId is string && notificationId.size() <= 128);
    }
  }
}
